# ══════════════════════════════════════════════════════════════════════════════
# .gitignore – FilmSite
# ══════════════════════════════════════════════════════════════════════════════

# ┌─────────────────────────────────────────────────────────────────────────┐
# │  ⛔  CRITICAL – NEVER COMMIT THESE FILES                               │
# │  They contain secrets that give full access to your Telegram account    │
# │  and server. If leaked, IMMEDIATELY revoke all tokens and session files.│
# └─────────────────────────────────────────────────────────────────────────┘

# Pyrogram / Telethon session files (contain Telegram auth token!)
bot/*.session*
*.session*
*.session
*.session-journal
**/*.session*

# Environment variable files (API keys, tokens, passwords)
.env
.env.*
*.env
bot/.env
bot/.env.*
!.env.example
!bot/.env.example
seedr_accounts.json
bot/seedr_accounts.json
*.json.local
!seedr_accounts.example.json
!bot/seedr_accounts.example.json

# Cloudflare Wrangler secrets & local cache
.dev.vars
wrangler.toml.local
.wrangler/

# Binaries & executables
bin/
bin/**
*.exe

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# Virtual environments
venv/
.venv/
env/
ENV/
bot/venv/
bot/.venv/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/

# Testing
.pytest_cache/
.coverage
htmlcov/
*.cover
.tox/

# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules/
scripts/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/

# ── Temporary / system files ──────────────────────────────────────────────────
/tmp/
*.tmp
*.temp
*.swp
*.swo
*~
Thumbs.db
.DS_Store
desktop.ini
.directory

# ── Logs ─────────────────────────────────────────────────────────────────────
bot.log
bot_out.log
bot_err.log
*.log
logs/
bot/logs/

# ── IDE / Editor settings ─────────────────────────────────────────────────────
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.history/

# ── Downloaded media (NEVER commit video files!) ──────────────────────────────
/tmp/downloads/
bot/downloads/
*.mp4
*.mkv
*.avi
*.mov
*.webm

# ── Scratch / helper scripts (generated by Antigravity) ───────────────────────
scripts/write_all_files.py
