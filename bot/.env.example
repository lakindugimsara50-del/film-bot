# ── Telegram credentials (https://my.telegram.org/apps) ──────────────────────
TG_API_ID=your_api_id_here
TG_API_HASH=your_api_hash_here

# ── Bot token (from @BotFather) ───────────────────────────────────────────────
BOT_TOKEN=your_bot_token_here

# ── Admin user IDs (comma-separated) ─────────────────────────────────────────
ADMIN_IDS=123456789,987654321

# ── Telegram channel IDs ──────────────────────────────────────────────────────
PRIVATE_CHANNEL_ID=-100xxxxxxxxxx
PUBLIC_CHANNEL_ID=-100xxxxxxxxxx

# ── TMDB (https://www.themoviedb.org/settings/api) ───────────────────────────
TMDB_API_KEY=your_tmdb_key_here

# ── GitHub (needs repo scope) ─────────────────────────────────────────────────
GITHUB_TOKEN=ghp_xxxxxxxxxxxxx
GITHUB_REPO=yourusername/yourrepo

# ── Streaming proxy base URL ──────────────────────────────────────────────────
STREAM_BASE_URL=https://stream.yourdomain.workers.dev

# ── Public site URL ───────────────────────────────────────────────────────────
SITE_BASE_URL=https://filmsub.pages.dev

# ── Pyrogram userbot session name (file will be SESSION_NAME.session) ─────────
SESSION_NAME=session
