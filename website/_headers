# _headers – Cloudflare Pages custom response headers
# Docs: https://developers.cloudflare.com/pages/configuration/headers/
#
# Format:
#   /path/pattern
#     Header-Name: value

# ══════════════════════════════════════════════════════════════════════════════
# Global security headers – applied to ALL pages
# ══════════════════════════════════════════════════════════════════════════════
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://vjs.zencdn.net https://www.youtube.com https://monetag.com https://pagead2.googlesyndication.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://vjs.zencdn.net; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com https://vjs.zencdn.net data:; img-src 'self' data: https:; media-src 'self' blob: data: https: http:; connect-src 'self' blob: data: https: http:; frame-src 'self' https: http: blob:; object-src 'none'; base-uri 'self'; form-action 'self';
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# ══════════════════════════════════════════════════════════════════════════════
# Cache – static assets with content hash (1 year, immutable)
# ══════════════════════════════════════════════════════════════════════════════
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=31536000, immutable

# Images – 30 days
/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/thumbnails/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=3600

# ══════════════════════════════════════════════════════════════════════════════
# HTML pages – short cache, always revalidate
# ══════════════════════════════════════════════════════════════════════════════
/*.html
  Cache-Control: public, max-age=300, stale-while-revalidate=60

/
  Cache-Control: public, max-age=300, stale-while-revalidate=60

# ══════════════════════════════════════════════════════════════════════════════
# Data files
# ══════════════════════════════════════════════════════════════════════════════
/data/*.json
  Cache-Control: public, max-age=120, stale-while-revalidate=60
  Content-Type: application/json; charset=utf-8

# ══════════════════════════════════════════════════════════════════════════════
# Subtitle / caption files – CORS so video.js can load them cross-origin
# ══════════════════════════════════════════════════════════════════════════════
/subs/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Content-Type: text/vtt; charset=utf-8
  Cache-Control: public, max-age=86400

/subtitles/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Cache-Control: public, max-age=86400

/*.vtt
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Content-Type: text/vtt; charset=utf-8
  Cache-Control: public, max-age=86400

/*.srt
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

# ══════════════════════════════════════════════════════════════════════════════
# Sitemap + robots
# ══════════════════════════════════════════════════════════════════════════════
/sitemap.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8

# ══════════════════════════════════════════════════════════════════════════════
# ads.txt – no cache so ad networks see updates fast
# ══════════════════════════════════════════════════════════════════════════════
/ads.txt
  Cache-Control: no-cache
  Content-Type: text/plain; charset=utf-8
